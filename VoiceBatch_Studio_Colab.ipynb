      "cell_type": "markdown",
      "metadata": { "id": "header" },
      "source": [
        "# 🎙️ VoiceBatch Studio v2.0.7 - [Pause & Emotion Fix]\n",
        "यह वर्जन खास तौर पर '...' और '?' जैसे सिंबल्स पर रुकने और हकलाहट रोकने के लिए है।"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": { "id": "step1" },
      "source": [
        "# @title 📥 Step 1: GitHub Root & Strict Control\n",
        "import os\n",
        "GITHUB_USER = \"\" # @param {type:\"string\"}\n",
        "GITHUB_TOKEN = \"\" # @param {type:\"string\"}\n",
        "REPO_NAME = \"VoiceBatch_Studio\" # @param {type:\"string\"}\n",
        "\n",
        "os.makedirs(f\"{REPO_NAME}/configs\", exist_ok=True)\n",
        "!pip install -q gradio edge-tts librosa soundfile torchcodec coqui-tts\n",
        "\n",
        "print(\"✅ सिस्टम तैयार है। अब आपकी स्क्रिप्ट के सिंबल्स हकलाहट नहीं पैदा करेंगे।\")"
      ],
      "outputs": []
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": { "id": "step2" },
      "source": [
        "# @title 🚀 Step 2: app.py (Pause & Symbol Logic)\n",
        "app_code = r'''\n",
        "import gradio as gr\n",
        "import torch\n",
        "from TTS.api import TTS\n",
        "import librosa, soundfile as sf\n",
        "import os\n",
        "import re\n",
        "\n",
        "device = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
        "tts = TTS('tts_models/multilingual/multi-dataset/xtts_v2').to(device)\n",
        "\n",
        "def clean_and_pause(text):\n",
        "    # यह फंक्शन '...' को एक छोटे पॉज़ में बदल देगा ताकि AI हकलाए नहीं\n",
        "    text = text.replace(\"...\", \". \")\n",
        "    text = re.sub(r'([।?!,:;])', r' \1 ', text) # सिंबल्स के आसपास जगह बनाना\n",
        "    return text\n",
        "\n",
        "def mahadev_engine(text, audio_sample, speed, pitch, lang):\n",
        "    if not audio_sample: return None\n",
        "    \n",
        "    # स्क्रिप्ट को साफ़ करना\n",
        "    cleaned_text = clean_and_pause(text)\n",
        "    \n",
        "    out_dir = 'VoiceBatch_Studio/outputs'\n",
        "    os.makedirs(out_dir, exist_ok=True)\n",
        "    temp_out = f'{out_dir}/temp.wav'\n",
        "    \n",
        "    # भाषा और उच्चारण पर 1000% लगाम\n",
        "    tts.tts_to_file(\n",
        "        text=cleaned_text, \n",
        "        speaker_wav=audio_sample, \n",
        "        language=lang, \n",
        "        file_path=temp_out,\n",
        "        split_sentences=True # वाक्यों को अलग-अलग पढ़ना ताकि पॉज़ मिले\n",
        "    )\n",
        "    \n",
        "    y, sr = librosa.load(temp_out)\n",
        "    # आवाज़ को गहरा (Deep) बनाने के लिए हल्का सा पिच शिफ्ट\n",
        "    if pitch != 0: y = librosa.effects.pitch_shift(y, sr=sr, n_steps=pitch)\n",
        "    \n",
        "    final_path = f'{out_dir}/final_emotion.wav'\n",
        "    sf.write(final_path, y, sr)\n",
        "    return final_path\n",
        "\n",
        "with gr.Blocks(theme=gr.themes.Soft(primary_hue=\"orange\")) as demo:\n",
        "    gr.Markdown('# 🎙️ VoiceBatch Studio v2.0.7 - Emotional Voice')\n",
        "    with gr.Row():\n",
        "        with gr.Column():\n",
        "            txt = gr.Textbox(label='महादेव वाली स्क्रिप्ट यहाँ डालें', lines=8, placeholder='यहाँ ... और ? का सही उपयोग करें')\n",
        "            smp = gr.Audio(label='वॉइस सैंपल (गहरी आवाज़ के लिए)', type='filepath')\n",
        "            lng = gr.Dropdown(choices=['hi', 'en'], label='Language Lock', value='hi')\n",
        "            with gr.Row():\n",
        "                spd = gr.Slider(0.75, 1.1, 0.9, step=0.01, label=\"Speed (इमोशनल के लिए कम रखें)\")\n",
        "                ptc = gr.Slider(-3, 3, -1, step=1, label=\"Pitch (गंभीरता के लिए -1 रखें)\")\n",
        "            btn = gr.Button('Generate Emotional Voice 🔱', variant='primary')\n",
        "        with gr.Column():\n",
        "            out = gr.Audio(label='फाइनल आउटपुट')\n",
        "\n",
        "    btn.click(mahadev_engine, [txt, smp, spd, ptc, lng], out)\n",
        "\n",
        "demo.launch(share=True)\n",
        "'''\n",
        "with open('app.py', 'w') as f: f.write(app_code)\n",
        "print(\"✅ इमोशनल पॉज़ फिक्स के साथ ऐप तैयार है!\")\n",
        "!python app.py"
      ],
      "outputs": []
    }
  ],
